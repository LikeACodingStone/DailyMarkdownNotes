#!/bin/bash
#

unset GREP_OPTIONS
unset GIT_DIR

INT_REPO=$(git remote -v show | sed -n 's|.*:29418/\(.*\) (fetch)|\1|p')
SEL_OPT='-C'             # running on git client
SEL_PAR='${SUBM_PATH}'   # single quotes on purpose: will be bash re-eval-uated

function normalize_submodule_url()
{
    local REDUCED=$(echo "$1" | sed -e 's|/[^./]\+/\.\./|/|' -e 's|^[^./]\+/\.\./||')
    [ "$1" != "${REDUCED}" ] && normalize_submodule_url "${REDUCED}" || echo "$1"
}

# LINE_BUF: original line
# CHG_ID: Change-ID (unused)
# AUTHOR: Author string (unused)
# DATE: Date string (unused)
# JIRA_NEWSTYLE: bash array with keys being new style Jira Inline Issues
# JIRA_OLDSTYLE: bash array with keys being old style Jire extra line Issues
# BODY: Body of Commit-Message (catch all: all other)
# SUBM: submodule name associated with buffer
# *_TMP: the commit of the next submodule/change flush the change use tmp variables before

function reformat_log()
{
    awk '
        BEGIN { if (match(ENVIRON["OS"], "Windows")) RS="\r?\n" }
        function add_2_submodule_buffer() { BODY=BODY PREFIX LINE_COMMENT "\n" }
        function flush_submodule_buffer()
        {
            if (GIT_ID != "")
            {
                for (X in JIRA_OLDSTYLE) if (JIRA_NEWSTYLE[X] != 1) BODY=BODY PREFIX "Jira-Issue: " X "\n"
                if (match(AUTHOR,/^(.*) <.*>/,re)) AUTHOR=re[1]
                if (MERGE != "") print SUBM " " substr(GIT_ID,1,8) ", " MERGE ", " AUTHOR ", " DATE
                else             print SUBM " " substr(GIT_ID,1,8) ", "            AUTHOR ", " DATE
                print BODY CHG_ID
                MERGE=AUTHOR=DATE=BODY=CHG_ID=""
                delete JIRA_NEWSTYLE
                delete JIRA_OLDSTYLE
            }
        }
        {
            LINE_BUF=$0
            LINE_COMMENT=""
            if (sub(/^    Change-Id: /, "", LINE_BUF)==1)
            {
                CHG_ID=PREFIX "Change-Id: " LINE_BUF "\n"
            }
            else if (sub(/^    [Jj][Ii][Rr][Aa]-[Ii][Ss][Ss][Uu][Ee]: */, ":", LINE_BUF)==1)
            {
                while (match(LINE_BUF,/^(.*[ ,:;\[])([A-Z][A-Z0-9_]+-[1-9][0-9]*)(.*)$/,re))
                { LINE_BUF=re[1]re[3]; JIRA_OLDSTYLE[re[2]]=1 }
            }
            else if (sub(/^    /, "", LINE_BUF)==1)
            {
                LINE_COMMENT=LINE_BUF
                while (match(LINE_BUF,/^(.*)\[([A-Z][A-Z0-9_]+-[1-9][0-9]*)\](.*)$/,re))
                { LINE_BUF=re[1]re[3]; JIRA_NEWSTYLE[re[2]]=1 }
            }
            LINE_BUF=$0
            if      (sub(/^Added /   , "", LINE_BUF)==1) { SUBM_TMP=$0; PREFIX_TMP=" + "; }
            else if (sub(/^Removed / , "", LINE_BUF)==1) { SUBM_TMP=$0; PREFIX_TMP=" - "; }
            else if (sub(/^Pullup /  , "", LINE_BUF)==1) { SUBM_TMP=$0; PREFIX_TMP=" > "; }
            else if (sub(/^Pulldown /, "", LINE_BUF)==1) { SUBM_TMP=$0; PREFIX_TMP=" < "; }
            else if (sub(/^commit /  , "", LINE_BUF)==1) { flush_submodule_buffer(); SUBM=SUBM_TMP; PREFIX=PREFIX_TMP; GIT_ID=LINE_BUF; }
            else if (sub(/^Author: / , "", LINE_BUF)==1) { AUTHOR=LINE_BUF; }
            else if (sub(/^Date:   / , "", LINE_BUF)==1) { DATE=LINE_BUF; }
            else if (sub(/^Merge: /  , "", LINE_BUF)==1) { MERGE="Merge: " LINE_BUF; }
            else if (LINE_COMMENT !=   ""              ) { add_2_submodule_buffer(); }
        }
        END { flush_submodule_buffer() }
    '
}

function submodule_log()
{
    local       SUBM_LOG SUBM_PATH SUBM_URL SUBM_FROM SUBM_TO
    while IFS=$'\t' read SUBM_PATH SUBM_URL SUBM_FROM SUBM_TO
    do
        [ '.' = "${SUBM_PATH}" ] && SUBM_DESC="Commit:" || SUBM_DESC="Submodule: ${SUBM_PATH}"
        if   [ '-' = "${SUBM_TO}"   ]
        then SUBM_LOG=$(eval git "${SEL_OPT}" "${SEL_PAR}" log -n1         "${SUBM_FROM}"); [ '' != "${SUBM_LOG}" ] && echo  "Removed ${SUBM_DESC}" && echo "${SUBM_LOG}"
        elif [ '-' = "${SUBM_FROM}" ]
        then SUBM_LOG=$(eval git "${SEL_OPT}" "${SEL_PAR}" log -n1           "${SUBM_TO}"); [ '' != "${SUBM_LOG}" ] && echo    "Added ${SUBM_DESC}" && echo "${SUBM_LOG}"
        else SUBM_LOG=$(eval git "${SEL_OPT}" "${SEL_PAR}" log "${SUBM_FROM}..${SUBM_TO}"); [ '' != "${SUBM_LOG}" ] && echo   "Pullup ${SUBM_DESC}" && echo "${SUBM_LOG}"
             SUBM_LOG=$(eval git "${SEL_OPT}" "${SEL_PAR}" log "${SUBM_TO}..${SUBM_FROM}"); [ '' != "${SUBM_LOG}" ] && echo "Pulldown ${SUBM_DESC}" && echo "${SUBM_LOG}"
        fi
    done | awk '{if (!truncate) print} /^    Update ([-*./0-9a-zA-Z]+, )*[-*./0-9a-zA-Z]+$/ {truncate=1}'
}

function integration_log()
{
    local                SUBM_NAME SUBM_PATH SUBM_URL SUBM_BRA SUBM_FROM SUBM_TO
    while IFS=$'\t' read SUBM_NAME SUBM_PATH SUBM_URL SUBM_BRA
    do
         if [ '.' = "${SUBM_PATH}" ]
         then SUBM_URL="/srv/git/${INT_REPO}.git"
              SUBM_FROM="${FROM}"
              SUBM_TO="${TO}"
         else SUBM_URL="/srv/git/$(normalize_submodule_url "${INT_REPO}/${SUBM_URL}").git"
              SUBM_FROM=$(git rev-parse "${FROM}:${SUBM_PATH}" 2>/dev/null) || SUBM_FROM='-'
              SUBM_TO=$(  git rev-parse   "${TO}:${SUBM_PATH}" 2>/dev/null) || SUBM_TO='-'
         fi
         [ "${SUBM_TO}" != "${SUBM_FROM}" ] && printf "%s\t%s\t%s\t%s\n" "${SUBM_PATH}" "${SUBM_URL}" "${SUBM_FROM}" "${SUBM_TO}"
    done
}

function list_submodules_updates()
{
    (
        git diff "${FROM}" "${TO}" --name-only  # list differing submodules
        echo                                    # separator used to run with sh (avoiding process substitution)
        (
            git show "${FROM}":.gitmodules 2>/dev/null
            git show   "${TO}":.gitmodules 2>/dev/null
        ) | sed 's|\(\.git\)\{0,1\}\r\{0,1\}||g' | sed 's|[\t ]*$||' |\
        awk 'function subm_print(){if(valid)printf("%s\t%s\t%s\t%s\n",subm,path,url,branch)};
             /\[submodule/{subm_print();subm=substr($2,2,length($2)-3);path=url=branch="";valid=1}
             /path = /{path=$3} /url = /{url=$3} /branch = /{branch=$3} END{subm_print()}' | sort -u
    ) | awk '{ if (!NF) separator=1; if (!separator) filter[i++]=$0; else for (i in filter) if ($2 == filter[i]) {print $0}}'
}

MAIN_LOG=$(git log -1 --pretty=%B)

# a line with just the case-insensitive 'LOG[-_]SUBMODULES' content triggeres the log insertion of submodule
# updates replacing it. git commit causes a recursion of the hook however any 'LOG[-_]SUBMODULES' keywords
# are filtered out so a recursed call will terminate without changing the state further. the second git commit
# just gets rid of the tmp_file.

if echo "${MAIN_LOG}" | grep -iq "^LOG[-_]SUBMODULES$"
then
    TMP_FILE=edit-commit-message.-$(date '+%s%N').tmp
    ! FROM="$(git rev-list -n1 HEAD~)" && echo "no repository or last reference" && exit 1
    ! TO="$(  git rev-list -n1 HEAD )" && echo "no repository or last reference" && exit 1
    (
        echo "${MAIN_LOG}"  | awk 'BEGIN{IGNORECASE=1;p=1}; /^LOG[-_]SUBMODULES$/{p=0}; p'
        SUBM_LIST=$(list_submodules_updates)
        echo "${SUBM_LIST}" | awk '{L=L", "$1} END {if (""!=L) print "Update "substr(L,3)}'
        echo
        echo "${SUBM_LIST}" | integration_log | submodule_log | reformat_log
        echo "${MAIN_LOG}"  | awk 'BEGIN{IGNORECASE=1};  p; /^LOG[-_]SUBMODULES$/{p=1}'
    ) | grep   -iv            "^LOG[-_]SUBMODULES$" > ${TMP_FILE}
    git add                                        -- ${TMP_FILE}
    git commit -q --amend --file=${TMP_FILE}    -o -- ${TMP_FILE}
    git rm     -q                                  -- ${TMP_FILE}
    git commit -q --amend --no-edit --no-verify -o -- ${TMP_FILE}
fi
